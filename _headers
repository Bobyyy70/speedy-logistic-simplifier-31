/*
  # Security Headers
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Opener-Policy: same-origin
  
  # Enhanced Content Security Policy - Formatted for readability and completeness
  Content-Security-Policy: default-src 'self'; 
    script-src 'self' 'unsafe-inline' 'unsafe-eval' 
      https://js.hs-scripts.com 
      https://js-eu1.hs-scripts.com
      https://js.hscollectedforms.net 
      https://js.hsleadflows.net 
      https://js.usemessages.com 
      https://*.googletagmanager.com 
      https://www.google-analytics.com 
      https://*.hs-analytics.net 
      https://js-eu1.hs-analytics.net
      https://js-eu1.hsforms.net 
      https://*.hsforms.net
      https://forms.hsforms.net
      https://js-eu1.hubspot.com
      https://js-eu1.hsadspixel.net
      https://*.hsadspixel.net
      https://*.hscollectedforms.net
      https://*.hubspot.com;
    style-src 'self' 'unsafe-inline' 
      https://fonts.googleapis.com 
      https://*.hubspot.com; 
    font-src 'self' 
      https://fonts.gstatic.com; 
    img-src 'self' data: https: blob:; 
    media-src 'self' https:; 
    object-src 'none'; 
    frame-src 'self' 
      https://app.hubspot.com 
      https://*.hsforms.com 
      https://*.hubspot.com 
      https://meetings-eu1.hubspot.com 
      https://storage.googleapis.com 
      https://maps.googleapis.com
      https://maps.google.com
      https://*.google.com; 
    connect-src 'self' 
      https://api.hubapi.com 
      https://*.hubspot.com 
      https://forms.hubspot.com 
      https://forms-eu1.hscollectedforms.net
      https://*.hscollectedforms.net
      https://*.hs-analytics.net 
      https://*.hs-banner.com 
      https://*.hsadspixel.net 
      https://*.usemessages.com 
      https://www.google-analytics.com 
      https://*.googleapis.com
      https://storage.googleapis.com;
    base-uri 'self'; 
    form-action 'self' https://forms.hubspot.com; 
    frame-ancestors 'none'; 
    upgrade-insecure-requests
  
  # Cache Control for static assets
  Cache-Control: public, max-age=31536000, immutable

/*.css
  Cache-Control: public, max-age=31536000, immutable

/*.js
  Cache-Control: public, max-age=31536000, immutable

/*.png
  Cache-Control: public, max-age=31536000, immutable

/*.jpg
  Cache-Control: public, max-age=31536000, immutable

/*.jpeg
  Cache-Control: public, max-age=31536000, immutable

/*.webp
  Cache-Control: public, max-age=31536000, immutable

/*.svg
  Cache-Control: public, max-age=31536000, immutable

/world-map-*.svg
  Cache-Control: public, max-age=31536000, immutable

/*.ico
  Cache-Control: public, max-age=31536000, immutable

/*.woff2
  Cache-Control: public, max-age=31536000, immutable

/*.woff
  Cache-Control: public, max-age=31536000, immutable

/*.ttf
  Cache-Control: public, max-age=31536000, immutable

# HTML files should not be cached aggressively
/*.html
  Cache-Control: public, max-age=300, s-maxage=604800, stale-while-revalidate=2592000

# API endpoints
/api/*
  Cache-Control: no-cache, no-store, must-revalidate

# Service Worker
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

# Manifest
/manifest.json
  Cache-Control: public, max-age=86400